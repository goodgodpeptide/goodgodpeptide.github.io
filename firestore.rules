rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.email in get(/databases/$(db)/documents/config/admins).data.emails;
    }
    function isApproved() {
      return isSignedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.email in get(/databases/$(db)/documents/config/approved_users).data.emails;
    }

    match /users/{uid} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == uid;
      }
      function nextSyncRevision() {
        return request.resource.data.get('syncRevision', -1) is int
          && request.resource.data.get('syncRevision', -1)
            == resource.data.get('syncRevision', 0) + 1;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.get('syncRevision', -1) == 1;
      allow update: if isOwner() && nextSyncRevision();
      allow delete: if isOwner();
    }
    // 🔮 사주(四柱) 정보 저장 — users/{uid} 문서 자체가 아니라 서브컬렉션(saju/profile).
    // 위 users/{uid} 규칙은 그 문서 자체에만 적용되고 서브컬렉션까지 자동 상속되지 않으므로
    // (backups/{uid}/{doc=**}처럼) 별도 match가 필요하다 — 없으면 저장 시 permission-denied.
    match /users/{uid}/saju/{doc} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /user_profiles/{uid} {
      allow read: if isApproved();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
    match /backups/{uid}/{doc=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /config/{doc} {
      // 현재 로그인 화면은 이 두 문서의 이메일 목록으로 자신의 권한을 확인한다.
      // rejected_users 및 그 밖의 설정은 관리 화면에서만 읽을 수 있다.
      allow get: if isAdmin() || (isSignedIn() && doc in ['admins', 'approved_users']);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    match /login_logs/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
    match /posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid
        && request.resource.data.likes is list && request.resource.data.likes.size() == 0;
      allow update: if isApproved() && (
        (request.resource.data.uid == resource.data.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
         request.resource.data.likes is list &&
         request.resource.data.likes.size() == request.resource.data.likes.toSet().size() &&
         request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
           .hasOnly([request.auth.uid]) &&
         resource.data.likes.toSet().difference(request.resource.data.likes.toSet())
           .hasOnly([request.auth.uid]))
        || isAdmin()
      );
      allow delete: if isApproved() && (resource.data.uid == request.auth.uid || isAdmin());
      match /comments/{cid} {
        allow read: if isApproved();
        allow create: if isApproved() && request.resource.data.uid == request.auth.uid;
        allow delete: if isApproved() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
    match /donation_requests/{id} {
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, update: if isAdmin();
    }
    match /hall_of_fame/{doc} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
  }
}
